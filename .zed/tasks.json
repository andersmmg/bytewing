[
  {
    "label": "Build and restart docker dev",
    "command": "docker compose -f deploy/docker-compose.dev.yml up --build -d --force-recreate bytewing",
    "hide": "on_success",
  },
  {
    "label": "Backend dev server",
    "command": "sh -c 'if [ -f deploy/.env ]; then set -a; . deploy/.env; set +a; fi; mkdir -p data config && BYTEWING_APP_URL=http://localhost:8080 BYTEWING_DATA_DIR=$PWD/data BYTEWING_CONFIG_DIR=$PWD/config exec go run ./cmd/bytewing'",
  },
  {
    "label": "UI dev server",
    "command": "cd web && pnpm run dev",
  },
  {
    "label": "Docs dev server",
    "command": "cd docs && pnpm run dev",
  },
  {
    "label": "Go tests",
    "command": "go test ./...",
    "hide": "on_success",
  },
  {
    "label": "UI tests",
    "command": "cd web && pnpm run test",
    "hide": "on_success",
  },
  {
    "label": "Generate sqlc code",
    "command": "make generate",
    "hide": "on_success",
  },
  {
    "label": "Go checks",
    "command": "go run golang.org/x/vuln/cmd/govulncheck@latest ./... && go run github.com/securego/gosec/v2/cmd/gosec@latest -exclude-dir=internal/db/sqlcgen -exclude=G703 ./...",
    "hide": "on_success",
  },
]
