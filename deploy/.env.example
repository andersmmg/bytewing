# Storage backend: s3 or local
BYTEWING_STORAGE_BACKEND=s3
# S3 endpoint URL
BYTEWING_S3_ENDPOINT=http://weed:8333
# S3 bucket region
BYTEWING_S3_REGION=us-east-1
# S3 bucket name
BYTEWING_S3_BUCKET=my-bucket
# S3 bucket prefix
BYTEWING_S3_PREFIX=bytewing-dev
# S3 auth access key
BYTEWING_S3_ACCESS_KEY_ID=admin
# S3 auth secret
BYTEWING_S3_SECRET_ACCESS_KEY=secret
# Force path-style URLs
BYTEWING_S3_FORCE_PATH_STYLE=true
# S3 bucket public endpoint URL
BYTEWING_S3_PUBLIC_ENDPOINT=
# Storage quota size (in bytes)
BYTEWING_QUOTA_BYTES=1073741824
# Whether to allow URL fetch
BYTEWING_ALLOW_URL_FETCH=true
# Minimum password length (default 10, minimum 3)
BYTEWING_MIN_PASSWORD_LENGTH=10
