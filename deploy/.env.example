# Storage backend: s3 or local
ZEFILE_STORAGE_BACKEND=s3
# S3 endpoint URL
ZEFILE_S3_ENDPOINT=http://weed:8333
# S3 bucket region
ZEFILE_S3_REGION=us-east-1
# S3 bucket name
ZEFILE_S3_BUCKET=my-bucket
# S3 bucket prefix
ZEFILE_S3_PREFIX=zefile-dev
# S3 auth access key
ZEFILE_S3_ACCESS_KEY_ID=admin
# S3 auth secret
ZEFILE_S3_SECRET_ACCESS_KEY=secret
# Force path-style URLs
ZEFILE_S3_FORCE_PATH_STYLE=true
# S3 bucket public endpoint URL
ZEFILE_S3_PUBLIC_ENDPOINT=
# Storage quota size (in bytes)
ZEFILE_QUOTA_BYTES=1073741824
# Whether to allow URL fetch
ZEFILE_ALLOW_URL_FETCH=true
